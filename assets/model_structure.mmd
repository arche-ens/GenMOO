---
config:
  layout: elk
  themeVariables:
    lineColor: '#554236'
    primaryTextColor: '#554236'
    fontFamily: consolas
    edgeLabelBackground: '#fff'
---
flowchart TB
    A[("ChemDiv.txt")] --> B("PrepareData.py")
    B --> D(["ChemDiv_kept.txt"]) & C("vocab.npy") & E("intsmiles.npz")
    C --> H("Train.py") & I("GenerateMolecules.py")
    E --> H
    H --> F("network.pth")
    F --> I
    I --> G(["new_molecules.txt"])
    G --> J("Docking")
    J --> K("CalculateProperties.py")
    K --> L("NondominatedSorting.py")
    L --> M(["top_molecules.txt"])
    M & C & F --> N("Refine.py")
    N --> O("network_refined.pth") -->|n times| I
    O --> P(["candidates"]):::green

     K:::orange
     J:::yellow
     A:::green
     B:::orange
     D:::green
     C:::blue
     E:::sakura
     H:::orange
     I:::orange
     F:::purple
     G:::green
     L:::orange
     M:::green
     N:::orange
     O:::purple
    classDef green fill:#B2DFDB,stroke:#00897B,stroke-width:2px
    classDef orange fill:#FFE0B2,stroke:#FB8C00,stroke-width:2px
    classDef blue fill:#BBDEFB,stroke:#1976D2,stroke-width:2px
    classDef yellow fill:#FFF9C4,stroke:#FBC02D,stroke-width:2px
    classDef pink fill:#F8BBD0,stroke:#C2185B,stroke-width:2px
    classDef purple fill:#E1BEE7,stroke:#8E24AA,stroke-width:2px
    classDef sakura fill:#f8c3cd,stroke:#b5495b